# Set values in the hosting environment, not in Git. Never use example credentials.
DATABASE_URL=
# One strong, random secret (32+ bytes); NextAuth and domain-separated JWT signing use it.
SESSION_SECRET=
# Exact public HTTPS origin, with no trailing slash, required in production:
WEB_ORIGIN=
NODE_ENV=development

# Optional. Required for multiple API instances and shared socket broadcasts.
REDIS_URL=
# API listens on PORT (default 8080); Next.js uses its own service PORT (default 3000).
# For separate web/API services set the web service's private API address:
INTERNAL_API_URL=http://127.0.0.1:8080

# Optional payment configuration: all three are required to enable live payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional password-reset delivery. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=

# Optional supplementary critical-reading SMS alerts; not emergency dispatch.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional R2 uploads. Uploaded care documents must be access controlled.
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=
SENTRY_DSN=
